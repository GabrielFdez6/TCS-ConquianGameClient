<Window x:Class="ConquiánCliente.View.Lobby.InviteFriendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:ConquiánCliente.Properties.Langs"
        mc:Ignorable="d"
        Title="{x:Static lang:Lang.GlobalInvite}" Height="520" Width="428" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Background="#2E2E2E">

    <Window.Resources>
        <Style x:Key="LobbyHostButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#A43C42" BlurRadius="10" ShadowDepth="2" Opacity="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Effect" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView Grid.Row="0" ItemsSource="{Binding FriendsList}" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="350" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40" Height="40" CornerRadius="20" Grid.Column="0" ClipToBounds="True">
                            <Image Source="{Binding ProfileImagePath}" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="{Binding Nickname}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Content="{x:Static lang:Lang.GlobalInvite}" 
                                Command="{Binding DataContext.InviteFriendCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsOnline}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="100"></Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="1"
                Content="{x:Static lang:Lang.LobbySendRoomCode}"
                Style="{StaticResource LobbyHostButtonStyle}" HorizontalAlignment="Center"
                Width="200" 
                Height="50"
                Margin="0,15,0,0">
        </Button>
    </Grid>
</Window>