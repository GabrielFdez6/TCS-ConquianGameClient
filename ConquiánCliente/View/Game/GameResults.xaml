<Window x:Class="ConquiánCliente.View.Game.GameResults"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:ConquiánCliente.Properties.Langs"
        mc:Ignorable="d"
        Title="{x:Static language:Lang.GameResultsTitle}"
        Height="1080" Width="1920"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Grid>
        <Image Source="/Resources/backgroundGame.jpg"
               Stretch="UniformToFill"/>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="800"
                Background="#CC222222"
                CornerRadius="10"
                Padding="40">

            <StackPanel Orientation="Vertical">

                <TextBlock Text="{x:Static language:Lang.GameVictory}" 
                           FontSize="60"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <Grid HorizontalAlignment="Center" Margin="0,20,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="30,0">
                        <Border Width="120" Height="120"
                                BorderBrush="Gray" BorderThickness="1"
                                CornerRadius="60">
                            <Image Source="C:\Tecnologias para el desarrollo de software\Cliente\TCS-ConquianGameClient\ConquiánCliente\Resources\imageProfile\avatar03.JPG" 
                                   Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="{Binding PlayerName}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Jugador"
                                   FontSize="20"
                                   Foreground="LightGray"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="VS"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="25,0,25,-30"/>

                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="30,0">
                        <Border Width="120" Height="120"
                                BorderBrush="Gray" BorderThickness="1"
                                CornerRadius="60">
                            <Image Source="C:\Tecnologias para el desarrollo de software\Cliente\TCS-ConquianGameClient\ConquiánCliente\Resources\imageProfile\avatar01.JPG" 
                                   Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="{Binding OpponentName}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Oponente"
                                   FontSize="20"
                                   Foreground="LightGray"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Vertical" Margin="0,60,0,0" Width="350"
                            HorizontalAlignment="Center">

                    <Button Content="{x:Static language:Lang.GameBackToLobby}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="55"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,0,0,20"
                            Command="{Binding BackToLobbyCommand}">
                        <Button.Effect>
                            <DropShadowEffect Color="#A43C42"
                                              BlurRadius="10"
                                              ShadowDepth="2"
                                              Opacity="1"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>