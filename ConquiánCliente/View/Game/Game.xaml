<Window x:Class="ConquiánCliente.View.Game.Game"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:ConquiánCliente.Properties.Langs"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Partida"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="Black">

    <Window.Resources>
        <DataTemplate x:Key="CardTemplate">
            <Border Width="144" Height="216" Margin="-20"
                    BorderBrush="Yellow"
                    BorderThickness="0">
                <Image Source="{Binding ImagePath}" ToolTip="{Binding Id}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OpponentCardTemplate">
            <Image Source="/Resources/Assets/reverso.jpg" 
                   Width="144" Height="216" 
                   Margin="5, 5, -114, 5"/>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Image Source="/Resources/backgroundGame.jpg" Stretch="UniformToFill"/>

        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click" Margin="20"
                            Width="50" Height="50" Content="&lt;" FontSize="24" FontWeight="Bold"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <Button.Effect>
                            <DropShadowEffect Color="#A43C42" BlurRadius="10" ShadowDepth="2" Opacity="1"/>
                        </Button.Effect>
                    </Button>
                    <Border Grid.Column="1" HorizontalAlignment="Center" Padding="15,5"
                                Background="#66000000" CornerRadius="5" Margin="0,0,0,45" Width="220">
                        <TextBlock Text="{Binding GameTimeDisplay}" FontSize="28" 
                                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,100,60,0">
                    <Border Width="80" Height="80" BorderBrush="Gray" BorderThickness="1">
                        <Image Source="{Binding Opponent.pathPhoto}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Opponent.nickname}" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="24" FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>

                <ItemsControl HorizontalAlignment="Left"
                      VerticalAlignment="Top" 
                      Margin="820,130,0,0"
                      ItemTemplate="{StaticResource OpponentCardTemplate}"
                      ItemsSource="{Binding OpponentFaceDownCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                </ItemsControl>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="830,0,0,0">
                    <Grid Margin="0,0,15,0">
                        <Image Source="/Resources/Assets/reverso.jpg" Width="144" Height="216"/>
                    </Grid>
                    <Image Source="{Binding TopDiscardCard.ImagePath}"
                           Width="144" Height="216" Margin="20,0,0,0"/>
                </StackPanel>

                <Button Content="{x:Static language:Lang.GameToPass}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="910,0,0,310" Width="180" Height="55"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <Button.Effect>
                        <DropShadowEffect Color="#A43C42" BlurRadius="10" ShadowDepth="2" Opacity="1"/>
                    </Button.Effect>
                </Button>

                <ItemsControl ItemsSource="{Binding PlayerHand}"
                              ItemTemplate="{StaticResource CardTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" Margin="60,0,0,60">
                    <Border Width="80" Height="80" BorderBrush="Gray" BorderThickness="1">
                        <Image Source="{Binding CurrentPlayer.pathPhoto}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentPlayer.nickname}" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="24" FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="430,0,0,238">

                    <TextBlock Text="{Binding TurnStatusText}" FontSize="28"
                           FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding TurnTimeDisplay}" FontSize="28"
                           FontWeight="Bold" Foreground="Yellow"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>