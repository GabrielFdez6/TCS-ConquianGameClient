<Window x:Class="ConquiánCliente.View.Game.Game"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:ConquiánCliente.Properties.Langs"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Partida"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="Black">

    <Window.Resources>

        <DataTemplate x:Key="CardTemplate">
            <Border Width="144" Height="216" Margin="-20"
                    MouseLeftButtonDown="PlayerCardMouseLeftButtonDown"
                    MouseMove="PlayerCardMouseMove"
                    MouseLeftButtonUp="PlayerCardMouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="4"/>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="Yellow"/>
                                <Setter Property="BorderThickness" Value="4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Source="{Binding ImagePath}" ToolTip="{Binding Id}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OpponentCardTemplate">
            <Image Source="/Resources/Assets/reverso.png" 
                   Width="144" Height="216" 
                   Margin="5, 5, -114, 5"/>
        </DataTemplate>

        <DataTemplate x:Key="MeldedCardTemplate">
            <Border Width="100" Height="150" Margin="-35, 0, -35, 0">
                <Image Source="{Binding ImagePath}" ToolTip="{Binding Id}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MeldTemplate">
            <ItemsControl 
                ItemsSource="{Binding Cards}"
                ItemTemplate="{StaticResource MeldedCardTemplate}"
                Margin="0, 0, 0, 10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="DragCardVisualTemplate">
            <Image Source="{Binding ImagePath}" 
           Width="144" 
           Height="216"
           RenderOptions.BitmapScalingMode="HighQuality" />
        </DataTemplate>

        <DataTemplate x:Key="DragMeldVisualTemplate">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding ImagePath}" 
                               Width="144" 
                               Height="216"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="-100,0,0,0" />

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                <Setter Property="Margin" Value="0"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="RootGrid" 
          AllowDrop="True" 
          DragOver="RootGridDragOver">

        <Image Source="/Resources/backgroundGame.jpg" Stretch="UniformToFill"/>

        <Viewbox Stretch="Uniform">

            <Grid x:Name="MainGrid" Width="1920" Height="1080"
                  GiveFeedback="MainGridGiveFeedback">

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BackButton" Click="BackButtonClick" Margin="20"
                            Width="50" Height="50"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <TextBlock Text="&lt;"
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Border Grid.Column="1" HorizontalAlignment="Center" Padding="15,5"
                                Background="#66000000" CornerRadius="5" Margin="0,0,130,45" Width="220">
                        <TextBlock Text="{Binding GameTimeDisplay}" FontSize="28" 
                                   FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,100,60,0">
                    <Border Width="80" Height="80" BorderBrush="Gray" BorderThickness="1">
                        <Image Source="{Binding Opponent.pathPhoto}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Opponent.nickname}" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="24" FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>

                <ItemsControl HorizontalAlignment="Center"
                              VerticalAlignment="Top" 
                              Margin="0,130,0,0"
                              ItemTemplate="{StaticResource OpponentCardTemplate}"
                              ItemsSource="{Binding OpponentFaceDownCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl x:Name="OpponentMeldsItemsControl"
                              ItemsSource="{Binding OpponentMelds}"
                              ItemTemplate="{StaticResource MeldTemplate}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,280,60,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Margin="0,35,0,0">

                    <Image x:Name="DiscardPileImage"
                           Source="{Binding TopDiscardCard.ImagePath}"
                           Width="144" Height="216" 
                           Margin="0,0,20,0"
                           MouseLeftButtonDown="DiscardCardMouseLeftButtonDown"
                           MouseMove="DiscardCardMouseMove"
                           Cursor="Hand"/>

                    <Border x:Name="DropZone"
                            VerticalAlignment="Center"
                            Width="450" Height="250"
                            Background="#40FFFFFF" 
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="10"
                            AllowDrop="True"
                            Drop="DropZoneDrop"
                            DragEnter="DropZoneDragEnter"
                            DragLeave="DropZoneDragLeave">

                        <Grid>
                            <TextBlock Text="{x:Static language:Lang.GameDropZone}" 
                                       Foreground="White"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemporaryMeld.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding TemporaryMeld}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="100" Height="150" Margin="5">
                                            <Image Source="{Binding ImagePath}" ToolTip="{Binding Id}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemporaryMeld.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid x:Name="StockPileGrid" 
                          Margin="20,0,0,0"
                          MouseLeftButtonDown="StockPileMouseLeftButtonDown"
                          Cursor="Hand"
                          AllowDrop="True"
                          DragEnter="StockPileDragEnter"
                          Drop="StockPileDrop">
                        <Image Source="/Resources/Assets/reverso.png" Width="144" Height="216"/>
                    </Grid>

                </StackPanel>

                <Button HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="870,0,0,280" Width="180" Height="55"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <TextBlock Text="{x:Static language:Lang.GameToPass}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>

                <ItemsControl x:Name="PlayerMeldsItemsControl"
                              ItemsSource="{Binding PlayerMelds}"
                              ItemTemplate="{StaticResource MeldTemplate}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Margin="60,0,0,250">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl x:Name="PlayerHandItemsControl"    
                              ItemsSource="{Binding PlayerHand}"
                              ItemTemplate="{StaticResource CardTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,30"
                              AllowDrop="True"    
                              Drop="PlayerHandDrop">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" Margin="60,0,0,60">
                    <Border Width="80" Height="80" BorderBrush="Gray" BorderThickness="1">
                        <Image Source="{Binding CurrentPlayer.pathPhoto}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentPlayer.nickname}" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="24" FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="430,0,0,238">
                    <TextBlock Text="{Binding TurnStatusText}" FontSize="28"
                               FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TurnTimeDisplay}" FontSize="28"
                               FontWeight="Bold" Foreground="Yellow"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>